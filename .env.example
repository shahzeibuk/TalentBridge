# Local Postgres or a Neon connection string.
# On Vercel, use the Neon pooled host (the hostname contains "-pooler") and add
# sslmode, pgbouncer, and a single connection. Example:
# postgresql://USER:PASSWORD@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://talentbridge:talentbridge@127.0.0.1:5432/talentbridge?schema=public"

# openssl rand -base64 32
AUTH_SECRET="replace-with-openssl-rand-base64-32"

# Public origin of this app. Local dev uses the port in `npm run dev`.
# On Vercel set this to https://your-deployment.vercel.app
AUTH_URL="http://127.0.0.1:3847"

# gemini (default), groq, or fallback.
# gemini uses GEMINI_API_KEY. groq is used only when AI_PROVIDER=groq and GROQ_API_KEY is set.
# If the chosen key is missing, or the provider call fails, TalentBridge uses the local fallback extractor
# and labels that draft as local output, not model output.
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GROQ_API_KEY=""
