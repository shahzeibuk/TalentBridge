generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  profile         Profile?
  resumes         Resume[]
  gmailConnection GmailConnection?
  applications    JobApplication[]
  jobPostings     JobPosting[]
}

model Profile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName       String   @default("")
  email          String   @default("")
  phone          String   @default("")
  location       String   @default("")
  links          Json     @default("[]")
  experience     Json     @default("[]")
  education      Json     @default("[]")
  skills         Json     @default("[]")
  sourceResumeId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Resume {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName      String
  mimeType      String
  fileBytes     Bytes
  extractedText String   @db.Text
  status        String   @default("draft")
  fullName      String   @default("")
  email         String   @default("")
  phone         String   @default("")
  location      String   @default("")
  links         Json     @default("[]")
  experience    Json     @default("[]")
  education     Json     @default("[]")
  skills        Json     @default("[]")
  parseSource   String
  parseNote     String   @default("") @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  applications JobApplication[]

  @@index([userId, updatedAt])
}

model GmailConnection {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email                  String
  accessTokenCiphertext  String   @db.Text
  refreshTokenCiphertext String?  @db.Text
  accessTokenExpiresAt   DateTime
  scopes                 String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model JobApplication {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId       String?
  resume         Resume?   @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  company        String
  title          String
  contactEmail   String
  coverLetter    String    @db.Text
  subject        String
  status         String    @default("draft")
  gmailThreadId  String?
  gmailMessageId String?
  sentAt         DateTime?
  replyStatus    String    @default("unsent")
  replyFrom      String    @default("")
  replySnippet   String    @default("") @db.Text
  replyCheckedAt DateTime?
  lastError      String    @default("") @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, updatedAt])
}

model JobPosting {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceUrl   String   @default("")
  title       String
  company     String
  description String   @db.Text
  source      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, updatedAt])
}
